# LLM Provider API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GEMINI_API_KEY=AIzaSy-xxxxx

# Ollama (local models — no API key needed, just run: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434/v1

# RAG / Embeddings (defaults work out-of-the-box with Ollama)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434/v1
CHROMADB_PATH=~/.codebase-assistant/chromadb
SEARCH_TOP_K=10

# Default model to use (e.g., claude-sonnet-4-6, gpt-4o, gemini-2.0-flash, mistral:latest)
DEFAULT_MODEL=claude-sonnet-4-6
